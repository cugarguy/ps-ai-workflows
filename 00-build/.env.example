# Copy to .env and fill in. .env is gitignored, never commit your key.

# Your model provider key (OpenAI shown; adapt for your provider).
OPENAI_API_KEY=sk-...

# Model + bounds. These ARE your M5 deliverable, tune and justify them.
CORTEX_MODEL=gpt-4o-mini      # use a cheap, fast model; a full run is ~cents
CORTEX_MAX_ITERATIONS=8       # safety cap for read-only data-collection calls
# M2 policy in agent.py: initial draft + up to 3 critic-driven revisions,
# 300 seconds total. Legacy CORTEX_MAX_REVISIONS settings do not override it.
CORTEX_COST_CAP_USD=0.50      # hard spend cap per run, enforced outside the model
CORTEX_MAX_QUEUE_ITEMS=10     # commitment cap: max backlog stories queued per run

# Rough $ per 1M tokens for your chosen model (for the in-code cost estimate).
CORTEX_PRICE_IN_PER_M=0.15
CORTEX_PRICE_OUT_PER_M=0.60

# Independent validator; use matching prices if you change its model.
# Existing .env files can omit these: the code uses these defaults.
CORTEX_CRITIC_MODEL=gpt-4.1-mini
CORTEX_CRITIC_PRICE_IN_PER_M=0.40
CORTEX_CRITIC_PRICE_OUT_PER_M=1.60
